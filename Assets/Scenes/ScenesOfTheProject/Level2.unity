  m_Name: 
  m_EditorClassIdentifier: 
  badgeSpanish: "NIVEL 2 - ORG\u00c1NICO E INORG\u00c1NICO"
  badgeEnglish: "LEVEL 2 - ORGANIC & INORGANIC"
  titleSpanish: "\u00a1Separa frutas, latas y pl\u00e1stico!"
  titleEnglish: "Sort fruit, cans, and plastic!"
  descriptionSpanish: "Ahora tienes 3 objetos en la mesa: una c\u00e1scara de pl\u00e1tano, una lata de aluminio y una botella de pl\u00e1stico. \u00a1Clasif\u00edcalos en el bote correcto!"
  descriptionEnglish: "Now you have 3 objects on the table: a banana peel, an aluminum can, and a plastic bottle. Sort them into the right bin!"
  stepsSpanish: "1. Bote VERDE: Restos org\u00e1nicos (C\u00e1scara de pl\u00e1tano).\n2. Bote AZUL: Inorg\u00e1nicos reciclables (Lata de aluminio y Botella de pl\u00e1stico).\n3. Clasifica los 3 sin equivocarte para avanzar."
  stepsEnglish: "1. GREEN Bin: Organic scraps (Banana peel).\n2. BLUE Bin: Recyclable inorganics (Aluminum can and Plastic bottle).\n3. Sort all 3 without mistakes to advance."
  buttonSpanish: "Aceptar"
  buttonEnglish: "OK"
  badgeText: {fileID: 840395264008095041}
  titleText: {fileID: 3479103358459090704}
