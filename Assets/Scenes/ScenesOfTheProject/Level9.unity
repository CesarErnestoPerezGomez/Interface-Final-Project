  m_Name: 
  m_EditorClassIdentifier: 
  badgeSpanish: "NIVEL 9 - GRAN FINAL MAESTRO"
  badgeEnglish: "LEVEL 9 - GRAND FINALE MASTER"
  titleSpanish: "\u00a1Maestro de los 6 Basureros!"
  titleEnglish: "Master of All 6 Bins!"
  descriptionSpanish: "\u00a1Llegaste al \u00faltimo nivel! Tienes 6 residuos en la mesa, uno para cada uno de los 6 basureros de colores. \u00a1Demuestra todo lo que aprendiste!"
  descriptionEnglish: "You reached the final level! You have 6 waste items on the table, one for each of the 6 colored bins. Show everything you learned!"
  stepsSpanish: "1. Verde (Org\u00e1nico), Gris (Normal), Rojo (Punzocortantes).\n2. Azul (Inorg\u00e1nico), Amarillo (Vidrios), Naranja (Especiales).\n3. \u00a1Clasifica los 6 objetos para graduarte con 3 estrellas!"
  stepsEnglish: "1. Green (Organic), Grey (General), Red (Sharps).\n2. Blue (Inorganic), Yellow (Glass), Orange (Special).\n3. Sort all 6 items to graduate with 3 stars!"
  buttonSpanish: "Aceptar"
  buttonEnglish: "OK"
  badgeText: {fileID: 2122188848624066997}
  titleText: {fileID: 152859209384568108}
  descriptionText: {fileID: 3527529347994205302}
