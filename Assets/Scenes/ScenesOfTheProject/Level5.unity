  m_Script: {fileID: 11500000, guid: a0101010101040008000101010101001, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  badgeSpanish: "NIVEL 5 - \u00a1LOS 6 BASUREROS!"
  badgeEnglish: "LEVEL 5 - ALL 6 BINS!"
  titleSpanish: "\u00a1Ya est\u00e1n los 6 Basureros en juego!"
  titleEnglish: "All 6 Recycling Bins are here!"
  descriptionSpanish: "Se incorpora el 6\u00b0 basurero: el Bote NARANJA (Residuos Especiales como pilas). Ahora tienes los 6 basureros frente a ti: Verde, Gris, Rojo, Azul, Amarillo y Naranja."
  descriptionEnglish: "Introducing the 6th bin: the ORANGE Bin (Special waste like batteries). Now all 6 bins are in front of you: Green, Grey, Red, Blue, Yellow, and Orange."
  stepsSpanish: "1. Observa con atenci\u00f3n los 6 botes de colores frente a la mesa.\n2. Clasifica la c\u00e1scara de pl\u00e1tano, la lata de aluminio y la botella de pl\u00e1stico.\n3. Elige bien entre los 6 basureros sin equivocarte."
  stepsEnglish: "1. Look closely at all 6 colored bins in front of the table.\n2. Sort the banana peel, aluminum can, and plastic bottle.\n3. Choose carefully among all 6 bins without mistakes."
  buttonSpanish: "Aceptar"
  buttonEnglish: "OK"
  badgeText: {fileID: 4401208159427960659}
  titleText: {fileID: 1324421947608632183}
  descriptionText: {fileID: 1746380180535764819}
  stepsText: {fileID: 1836313567461539488}
