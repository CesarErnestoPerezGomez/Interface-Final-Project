  m_Name: 
  m_EditorClassIdentifier: 
  badgeSpanish: "NIVEL 3 - NUEVO BOTE: ROJO"
  badgeEnglish: "LEVEL 3 - NEW BIN: RED"
  titleSpanish: "\u00a1Cuidado con los Punzocortantes!"
  titleEnglish: "Be careful with Sharps & Needles!"
  descriptionSpanish: "Se incorpora el 4\u00b0 basurero: el Bote ROJO para objetos Punzocortantes y Agujas m\u00e9dicas, y practicaremos el Bote GRIS (todo menos l\u00edquido)."
  descriptionEnglish: "Introducing the 4th bin: the RED Bin for Sharps & Medical Needles, plus the GREY Bin (dry general waste)."
  stepsSpanish: "1. Bote ROJO: Jeringas y agujas (Punzocortantes).\n2. Bote GRIS: Envolturas y basura normal (todo menos l\u00edquido).\n3. Bote VERDE: C\u00e1scara de pl\u00e1tano (Org\u00e1nico)."
  stepsEnglish: "1. RED Bin: Syringes and needles (Sharps).\n2. GREY Bin: Wrappers and dry general trash.\n3. GREEN Bin: Banana peel (Organic)."
  buttonSpanish: "Aceptar"
  buttonEnglish: "OK"
  badgeText: {fileID: 802776377256630237}
