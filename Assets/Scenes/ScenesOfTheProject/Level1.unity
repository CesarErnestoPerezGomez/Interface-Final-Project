  m_Script: {fileID: 11500000, guid: a0101010101040008000101010101001, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  badgeSpanish: "NIVEL 1 - PRIMEROS BOTES"
  badgeEnglish: "LEVEL 1 - FIRST BINS"
  titleSpanish: "\u00a1Conoce los primeros 3 basureros!"
  titleEnglish: "Meet the first 3 recycling bins!"
  descriptionSpanish: "En este nivel aprender\u00e1s a diferenciar los primeros 3 colores: VERDE (Org\u00e1nico, como c\u00e1scaras de fruta), AZUL (Inorg\u00e1nico reciclable) y GRIS (Basura normal sin l\u00edquidos)."
  descriptionEnglish: "In this level you will learn the first 3 bin colors: GREEN (Organic food scraps), BLUE (Recyclable inorganic), and GREY (General dry waste)."
  stepsSpanish: "1. Observa la c\u00e1scara de pl\u00e1tano sobre la mesa.\n2. T\u00f3mala con el bot\u00f3n de agarre (Grip) y ll\u00e9vala al Bote VERDE (Org\u00e1nico).\n3. \u00a1Cuidado! Si te equivocas de bote, el nivel se reiniciar\u00e1."
  stepsEnglish: "1. Look at the banana peel on the table.\n2. Grab it with the grip button and drop it into the GREEN (Organic) bin.\n3. Careful! If you make a mistake, the level will restart."
  buttonSpanish: "Aceptar"
  buttonEnglish: "OK"
  badgeText: {fileID: 2855894387845483845}
  titleText: {fileID: 1610025614831611090}
  descriptionText: {fileID: 1409490411124961454}
  stepsText: {fileID: 3831673302182887584}
  acceptButton: {fileID: 3805333022375647602}
  acceptButtonText: {fileID: 4414128932058173559}
  retryNoticeText: {fileID: 278773521712719442}
  onAcceptClicked:
