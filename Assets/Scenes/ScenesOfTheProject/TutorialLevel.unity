  m_Name: 
  m_EditorClassIdentifier: 
  badgeSpanish: "TUTORIAL"
  badgeEnglish: "TUTORIAL"
  titleSpanish: "\u00a1Aprendamos los controles!"
  titleEnglish: "Let's learn the controls!"
  descriptionSpanish: "Hola, este es el nivel tutorial. Antes de empezar a clasificar residuos en los basureros, practiquemos c\u00f3mo tomar y soltar un cubo."
  descriptionEnglish: "Before we start sorting waste, let's practice picking up and releasing a cube."
  stepsSpanish: "1. Mant\u00e9n presionado el bot\u00f3n de agarre (Grip) o haz clic para tomar el cubo.\n2. Mu\u00e9velo sobre el \u00e1rea marcada (Zona de entrega).\n3. Suelta el bot\u00f3n de agarre para dejarlo caer."
  stepsEnglish: "1. Hold the grip button to pick up the cube.\n2. Move it over the marked area.\n3. Release the grip button to let go."
  buttonSpanish: "Aceptar"
  buttonEnglish: "OK"
  badgeText: {fileID: 2571255966659941865}
