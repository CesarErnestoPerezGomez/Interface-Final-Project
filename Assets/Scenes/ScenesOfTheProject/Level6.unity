  m_Name: 
  m_EditorClassIdentifier: 
  badgeSpanish: "NIVEL 6 - RESIDUOS ESPECIALES"
  badgeEnglish: "LEVEL 6 - SPECIAL WASTE"
  titleSpanish: "\u00a1Pilas, Vidrios y Punzocortantes!"
  titleEnglish: "Batteries, Glass, and Sharps!"
  descriptionSpanish: "En este nivel pondremos a prueba las categor\u00edas especiales: bater\u00edas usadas (Naranja), botellas de vidrio (Amarillo), jeringas (Rojo) y basura normal (Gris)."
  descriptionEnglish: "In this level we test the special categories: used batteries (Orange), glass bottles (Yellow), syringes (Red), and general dry waste (Grey)."
  stepsSpanish: "1. Bote NARANJA: Bater\u00eda usada (Especiales).\n2. Bote AMARILLO: Botella de vidrio.\n3. Bote ROJO: Jeringa m\u00e9dica.\n4. Bote GRIS: Envoltura seca."
  stepsEnglish: "1. ORANGE Bin: Used battery (Special).\n2. YELLOW Bin: Glass bottle.\n3. RED Bin: Medical syringe.\n4. GREY Bin: Dry snack wrapper."
  buttonSpanish: "Aceptar"
  buttonEnglish: "OK"
  badgeText: {fileID: 3083667183515555406}
  titleText: {fileID: 2983718659789183785}
