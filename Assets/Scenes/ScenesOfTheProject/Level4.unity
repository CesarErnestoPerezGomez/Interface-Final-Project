  m_Name: 
  m_EditorClassIdentifier: 
  badgeSpanish: "NIVEL 4 - NUEVO BOTE: AMARILLO"
  badgeEnglish: "LEVEL 4 - NEW BIN: YELLOW"
  titleSpanish: "\u00a1El Bote Amarillo para Vidrios!"
  titleEnglish: "The Yellow Bin for Glass!"
  descriptionSpanish: "Se incorpora el 5\u00b0 basurero: el Bote AMARILLO exclusivo para botellas y envases de Vidrio. \u00a1No lo confundas con las botellas de pl\u00e1stico!"
  descriptionEnglish: "Introducing the 5th bin: the YELLOW Bin exclusively for Glass bottles and jars. Don't confuse it with plastic bottles!"
  stepsSpanish: "1. Bote AMARILLO: Botella de vidrio.\n2. Bote AZUL: Botella de pl\u00e1stico (Inorg\u00e1nico).\n3. Bote VERDE: Manzana mordida (Org\u00e1nico).\n4. Bote ROJO: Jeringa (Punzocortantes)."
  stepsEnglish: "1. YELLOW Bin: Glass bottle.\n2. BLUE Bin: Plastic bottle (Inorganic).\n3. GREEN Bin: Apple core (Organic).\n4. RED Bin: Syringe (Sharps)."
  buttonSpanish: "Aceptar"
  buttonEnglish: "OK"
